    {"id":"enterprise-surface","kind":"enterprise_connector","status":"unavailable","operations":["read","import","export","reconcile"],"mutation":false,"external_send":false,"replacement_path":"approved organisation connector"},
    {"id":"fhir-exchange","kind":"standards_adapter","status":"contract_only","operations":["import","export","reconcile"],"mutation":false,"external_send":false,"replacement_path":"source-system FHIR profile"},
    {"id":"workflow-engine","kind":"optional_adapter","status":"unavailable","operations":["import","export"],"mutation":false,"external_send":false,"replacement_path":"approved CMMN BPMN DMN engine"}
  ],
  "participation": {
