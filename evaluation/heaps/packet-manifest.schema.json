{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcagent.local/schemas/heaps-packet-manifest-1.0",
  "title": "Detached HEAPS synthetic packet manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "data_class",
    "privacy_mode",
    "case_id",
    "profile_id",
    "profile_version",
    "hash_domain",
    "ordering",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": "heaps-packet-manifest-1.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "data_class": {
      "const": "generated_synthetic"
    },
    "privacy_mode": {
      "const": "fully_local"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "hash_domain": {
      "const": "sha256-raw-bytes-v1"
    },
    "ordering": {
      "const": "fixed-groups-path-ascending-v1"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "profile",
        "sources",
        "mapping",
        "template",
        "reports",
        "supporting_artifacts"
      ],
      "properties": {
        "case": {
          "$ref": "#/$defs/artifact_reference"
        },
        "profile": {
          "$ref": "#/$defs/artifact_reference"
        },
        "sources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/artifact_reference"
          }
        },
        "mapping": {
          "$ref": "#/$defs/artifact_reference"
        },
        "template": {
          "$ref": "#/$defs/artifact_reference"
        },
        "reports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/artifact_reference"
          }
        },
        "supporting_artifacts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/artifact_reference"
          }
        }
      }
    }
  },
  "$defs": {
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  }
}
