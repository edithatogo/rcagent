            }
          },
          "then": {
            "properties": {
              "raw_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
