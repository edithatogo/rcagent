{
  "$schema": "schemas/capability-profiles.schema.json",
  "schema_version": "1.0",
  "default_profile": "core",
  "policy": "optional-capabilities-must-not-weaken-core-safeguards",
  "installation_contract": {
    "agent_assisted": true,
    "scripted": true,
    "idempotent": true,
    "preflight_required": true,
    "verification_required": true,
    "receipt_required": true,
    "rollback_required": true,
    "uninstall_required": true,
    "network_egress_requires_disclosure": true,
    "telemetry_default": "off",
    "planned_is_not_installable": true
  },
  "profiles": [
    {"id": "core", "class": "core", "status": "implemented", "default": true, "owner_track": 0},
    {"id": "validate", "class": "optional", "status": "implemented", "default": false, "owner_track": 1, "implementation": {"entrypoint": "scripts/setup-capability.ps1", "support_scope": "preflight, installation ownership, independent verification, receipts, rollback refusal, and uninstall preview; update, executable rollback, and removal remain pending"}},
    {"id": "retrieval-lexical", "class": "optional", "status": "planned", "default": false, "owner_track": 7},
    {"id": "retrieval-vector", "class": "optional", "status": "planned", "default": false, "owner_track": 7},
    {"id": "documents-ocr", "class": "optional", "status": "planned", "default": false, "owner_track": 6},
    {"id": "speech-local", "class": "optional", "status": "planned", "default": false, "owner_track": 6},
    {"id": "medical-imaging-research", "class": "research-only", "status": "planned", "default": false, "owner_track": 6},
    {"id": "ecg-research", "class": "research-only", "status": "planned", "default": false, "owner_track": 6},
    {"id": "runtime-openvino", "class": "optional", "status": "planned", "default": false, "owner_track": 8},
    {"id": "runtime-mlx", "class": "optional", "status": "planned", "default": false, "owner_track": 8},
    {"id": "runtime-llamacpp", "class": "optional", "status": "planned", "default": false, "owner_track": 8},
    {"id": "runtime-mojo-experimental", "class": "experimental", "status": "planned", "default": false, "owner_track": 8},
    {"id": "enterprise-connectors", "class": "enterprise", "status": "planned", "default": false, "owner_track": 9},
    {"id": "client-adapters", "class": "optional", "status": "planned", "default": false, "owner_track": 11},
    {"id": "domain-adaptation", "class": "optional", "status": "planned", "default": false, "owner_track": 10}
  ]
}
