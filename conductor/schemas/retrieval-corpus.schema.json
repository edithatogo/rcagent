{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/rcagent/conductor/schemas/retrieval-corpus.schema.json",
  "title": "Retrieval corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "compartment", "units"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "compartment": {"enum": ["public", "governed_private", "ephemeral", "excluded"]},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "authority", "jurisdiction", "rights", "version", "timestamp", "location", "transformation", "compartment", "status", "content", "checksum", "retention"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "source": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "minLength": 1},
        "rights": {"enum": ["generated", "approved_public", "restricted", "unknown"]},
        "version": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "location": {"type": "object", "minProperties": 1},
        "transformation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "compartment": {"enum": ["public", "governed_private", "ephemeral", "excluded"]},
        "status": {"enum": ["current", "superseded", "deleted", "quarantined"]},
        "content": {"type": "string", "minLength": 1},
        "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "retention": {"type": "string", "minLength": 1}
      }
    }
  }
}
