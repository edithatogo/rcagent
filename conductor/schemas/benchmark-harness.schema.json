{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/rcagent/conductor/schemas/benchmark-harness.schema.json",
  "title": "Safety Systems Workbench benchmark harness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_version", "created_at", "governance", "dependencies", "metrics", "hard_gates", "cases", "legacy_map", "suites"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "benchmark_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["intended_decisions", "excluded_decisions", "permitted_data", "contamination_controls", "retirement", "reviewer_scoring"],
      "properties": {
        "intended_decisions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded_decisions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "permitted_data": {"const": ["synthetic", "public_rights_verified"]},
        "contamination_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "retirement": {"type": "object", "required": ["triggers", "challenge_path", "correction_policy"], "additionalProperties": {"type": "string"}},
        "reviewer_scoring": {"type": "object", "required": ["reviewer_class", "instructions", "agreement_metric", "unresolved_disagreement", "claim_boundary"], "additionalProperties": {"type": "string"}}
      }
    },
    "dependencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependency"}},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "hard_gates": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/gate"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "legacy_map": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/legacy"}},
    "suites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/suite"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "class", "status", "version", "licence", "source", "telemetry", "offline", "removal_condition"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "role": {"type": "string"},
        "class": {"enum": ["core", "evaluation-development", "optional-adapter"]},
        "status": {"enum": ["adopted", "assessed-not-installed", "rejected"]},
        "version": {"type": "string"}, "licence": {"type": "string"},
        "source": {"type": "string", "format": "uri"}, "telemetry": {"type": "string"},
        "offline": {"type": "boolean"}, "limitations": {"type": "string"},
        "removal_condition": {"type": "string"}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "definition", "aggregation", "uncertainty"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "category": {"type": "string"}, "definition": {"type": "string"}, "aggregation": {"type": "string"}, "uncertainty": {"type": "string"}}
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "condition", "effect", "owner"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "category": {"enum": ["privacy", "security", "clinical-safety", "cultural-safety", "harmful-output"]}, "condition": {"type": "string"}, "effect": {"const": "block_promotion"}, "owner": {"const": "accountable_human"}}
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256", "partition", "data_class", "modalities", "jurisdiction", "activation_status", "promotion_eligible", "challenge_classes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^evaluation/benchmark/fixtures/[a-z0-9][a-z0-9._/-]*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "partition": {"enum": ["train", "validation", "test"]},
        "data_class": {"enum": ["synthetic", "public_rights_verified"]},
        "modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "document", "audio", "image", "signal"]}},
        "jurisdiction": {"enum": ["national", "AU-NSW", "AU-QLD", "none"]},
        "activation_status": {"enum": ["active", "pending_owner_decision"]}, "decision_id": {"$ref": "#/$defs/id"},
        "promotion_eligible": {"type": "boolean"}, "challenge_classes": {"type": "array", "minItems": 1, "items": {"enum": ["incomplete", "conflicting", "distracting", "malicious", "policy_drift", "multimodal"]}}
      }
    },
    "legacy": {
      "type": "object", "additionalProperties": false,
      "required": ["condition", "source_paths", "mapping_status", "limitations"],
      "properties": {"condition": {"pattern": "^H[0-8]$"}, "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "mapping_status": {"enum": ["mapped", "partial", "incomparable", "no_evidence"]}, "limitations": {"type": "string"}}
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "case_ids", "runner", "network", "publication_status"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "runner": {"const": "deterministic-contract-v1"}, "network": {"const": "disabled"}, "publication_status": {"const": "internal_not_approved"}}
    }
  }
}
