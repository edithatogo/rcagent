{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/edithatogo/rcagent/conductor/schemas/multimodal-capability.schema.json",
  "title":"Multimodal capability registry",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","profiles","fixtures"],
  "properties":{
    "schema_version":{"const":"1.0"},"registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profiles":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/profile"}},
    "fixtures":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/fixture"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "profile":{"type":"object","additionalProperties":false,"required":["id","modality","framework","revision","licence","status","governance","privacy","limits","lifecycle","task","intended_use","exclusions","knowledge_limits","context_limit","evaluation","runtime","quantisation","ram","latency","regulatory","contribution_point"],"properties":{
      "id":{"$ref":"#/$defs/id"},"modality":{"enum":["document","encoder","speech","image","signal"]},
      "framework":{"type":"string"},"revision":{"type":"string"},"licence":{"type":"string"},
      "status":{"enum":["contract_only","assessed_not_installed","supported"]},
      "governance":{"enum":["conditional","research_disabled"]},
      "privacy":{"type":"object","required":["network","telemetry","cache","remote_code"],"additionalProperties":{"type":"string"}},
      "limits":{"type":"object","required":["inputs","outputs","failure_modes","device_classes"],"additionalProperties":true},
      "lifecycle":{"type":"object","required":["install","discover","health_check","rollback","uninstall","replacement"],"additionalProperties":{"type":"string"}},
      "task":{"type":"string"},"intended_use":{"type":"string"},"exclusions":{"type":"array","minItems":1,"items":{"type":"string"}},
      "knowledge_limits":{"type":"string"},"context_limit":{"type":"string"},"evaluation":{"type":"string"},
      "runtime":{"type":"string"},"quantisation":{"type":"string"},"ram":{"type":"string"},"latency":{"type":"string"},
      "regulatory":{"type":"string"},"contribution_point":{"type":"string"}
    }},
    "fixture":{"type":"object","additionalProperties":false,"required":["id","profile_id","synthetic","input","expected_provenance","interpretation_allowed"],"properties":{
      "id":{"$ref":"#/$defs/id"},"profile_id":{"$ref":"#/$defs/id"},"synthetic":{"const":true},
      "input":{"type":"object"},"expected_provenance":{"type":"array","minItems":1,"items":{"type":"object"}},
      "interpretation_allowed":{"const":false}
    }}
  }
}
