{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcagent.example/schemas/interface-workspace-1.0.json",
  "title": "Interface workspace registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "journeys", "workflows", "templates", "interfaces", "participation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_only", "external_actions", "enterprise_mutation", "automated_approval", "effectiveness_inferred_from_completion", "organisation_branding"],
      "properties": {
        "synthetic_only": {"const": true},
        "external_actions": {"const": false},
        "enterprise_mutation": {"const": false},
        "automated_approval": {"const": false},
        "effectiveness_inferred_from_completion": {"const": false},
        "organisation_branding": {"const": false}
      }
    },
    "journeys": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/journey"}},
    "workflows": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/workflow"}},
    "templates": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/template"}},
    "interfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interface"}},
    "participation": {
      "type": "object", "additionalProperties": false,
      "required": ["open_disclosure", "consumer_family", "staff_support", "procedural_fairness", "accessibility", "language_interpreter", "aboriginal_cultural_safety"],
      "properties": {
        "open_disclosure": {"const": "prompt_and_human_checkpoint"}, "consumer_family": {"const": "prompt_and_human_checkpoint"},
        "staff_support": {"const": "prompt_and_human_checkpoint"}, "procedural_fairness": {"const": "prompt_and_human_checkpoint"},
        "accessibility": {"const": "prompt_and_human_checkpoint"}, "language_interpreter": {"const": "prompt_and_human_checkpoint"},
        "aboriginal_cultural_safety": {"const": "prompt_and_human_checkpoint"}
      }
    }
  },
  "$defs": {
    "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "journey": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "checkpoints", "failure_recovery", "accessibility"],
      "properties": {"role": {"enum": ["investigator", "reviewer", "consumer_family", "staff", "governance", "executive", "auditor"]}, "checkpoints": {"$ref": "#/$defs/nonemptyStrings"}, "failure_recovery": {"$ref": "#/$defs/nonemptyStrings"}, "accessibility": {"$ref": "#/$defs/nonemptyStrings"}}
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "purpose", "steps", "methods", "human_checkpoints", "system_of_record"],
      "properties": {"id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "steps": {"$ref": "#/$defs/nonemptyStrings"}, "methods": {"type": "array", "items": {"enum": ["RCA", "SEIPS", "AcciMap", "FRAM", "STPA", "bow_tie", "barrier_analysis", "FMEA"]}}, "human_checkpoints": {"$ref": "#/$defs/nonemptyStrings"}, "system_of_record": {"const": "external_approved_platform"}}
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "rights", "fields", "audiences", "disclaimers"],
      "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "rights": {"enum": ["original_apache_2_0", "linked_only"]}, "fields": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "canonical_path", "provenance_required"], "properties": {"name": {"type": "string", "minLength": 1}, "canonical_path": {"enum": ["$.evidence", "$.statements[*].uncertainty", "$.statements[*].kind=recommendation", "$.actions", "$.outcomes", "$.statements[*].kind=reported_account", "$.reviews"]}, "provenance_required": {"const": true}}}}, "audiences": {"$ref": "#/$defs/nonemptyStrings"}, "disclaimers": {"type": "array", "allOf": [{"contains": {"const": "clinical"}}, {"contains": {"const": "policy"}}, {"contains": {"const": "legal"}}, {"contains": {"const": "organisational"}}, {"contains": {"const": "external_action"}}]}}
    },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "operations", "mutation", "external_send", "replacement_path"],
      "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "status": {"enum": ["contract_only", "unavailable"]}, "operations": {"type": "array", "items": {"enum": ["read", "import", "export", "reconcile"]}}, "mutation": {"const": false}, "external_send": {"const": false}, "replacement_path": {"type": "string", "minLength": 1}}
    }
  }
}
